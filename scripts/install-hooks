#!/usr/bin/env bash
# scripts/install-hooks — point the public repo's git at scripts/hooks.
#
# Git never runs hooks it fetched, so a fresh clone has none until this runs.
# It sets core.hooksPath in .git/config only. The private repo (.private.git)
# is deliberately left alone: the leak check guards the public remote, and the
# private remote is where the names belong. `npm test` covers public files, so
# running it on a private push would prove nothing about what is being pushed.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
chmod +x scripts/hooks/*
git config core.hooksPath scripts/hooks
echo "hooks installed: $(git config core.hooksPath) (pre-commit, commit-msg, pre-push)"
